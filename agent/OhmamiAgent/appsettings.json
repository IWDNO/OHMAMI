{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "Host": "0.0.0.0",
  "Port": 5000,
  "MetricsIntervalSeconds": 2,
  "MdnsServiceType": "_ohmami._tcp",
  "MdnsServiceNameTemplate": "Ohmami-{0}._ohmami._tcp.local.",

  "BlacklistPaths": [
      "C:\\Windows",
      "C:\\Program Files",
      "C:\\Program Files (x86)",
      "C:\\Users\\Default",
      "C:\\Users\\Public\\Libraries"
    ],
    "BlacklistAppliesToRead": true
}
